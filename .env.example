# Tùy chọn cho Docker Compose. Không cần tạo .env để chạy mặc định.
# Cổng API trên máy host; đổi nếu 8080 đang được ứng dụng khác sử dụng.
API_PORT=8080
# Dùng 0.0.0.0 nếu muốn thiết bị/máy khác trong LAN gọi API demo.
API_BIND_ADDRESS=127.0.0.1
# DB password và JWT secret được tự sinh, lưu trong Docker volume demo_secrets.
